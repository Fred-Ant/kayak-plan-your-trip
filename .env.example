# Modèle de fichier de configuration.
# 1) Copier ce fichier en ".env" (même dossier)   2) Renseigner les valeurs
# Le fichier .env est exclu de Git par .gitignore : il ne doit JAMAIS être publié.

# --- OpenWeatherMap (One Call API 3.0) ---
OWM_API_KEY=

# --- AWS : utilisateur IAM dédié "kayak-project" (jamais les clés du compte root) ---
# boto3 lit automatiquement ces trois variables d'environnement.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3

# --- Data Lake S3 ---
S3_BUCKET_NAME=

# --- Data Warehouse : AWS RDS PostgreSQL (renseigné à l'étape 5) ---
RDS_HOST=
RDS_PORT=5432
RDS_DB_NAME=kayak
RDS_USER=
RDS_PASSWORD=
