{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListKayakBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::kayak-plan-your-trip-fo"
    },
    {
      "Sid": "ReadWriteKayakObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::kayak-plan-your-trip-fo/*"
    }
  ]
}
